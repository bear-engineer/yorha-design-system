{
  "$schema": "https://www.designtokens.org/schemas/2025.10/resolver.json",
  "name": "yorha",
  "version": "2025.10",
  "description": "Resolver for the YoRHa token set: one base set, three modifiers (theme, density, motion).",
  "sets": {
    "base": {
      "sources": [
        {
          "$ref": "base.tokens.json"
        }
      ]
    }
  },
  "modifiers": {
    "theme": {
      "description": "data-theme on any element; light is :root.",
      "contexts": {
        "light": [
          {
            "$ref": "theme.light.tokens.json"
          }
        ],
        "dark": [
          {
            "$ref": "theme.dark.tokens.json"
          }
        ],
        "authentic": [
          {
            "$ref": "theme.authentic.tokens.json"
          }
        ],
        "high-contrast": [
          {
            "$ref": "theme.high-contrast.tokens.json"
          }
        ]
      },
      "default": "light"
    },
    "density": {
      "description": "data-density on any element.",
      "contexts": {
        "default": [],
        "compact": [
          {
            "$ref": "density.compact.tokens.json"
          }
        ],
        "comfortable": [
          {
            "$ref": "density.comfortable.tokens.json"
          }
        ]
      },
      "default": "default"
    },
    "motion": {
      "description": "data-motion on <html> (or a subtree).",
      "contexts": {
        "full": [],
        "reduced": [
          {
            "$ref": "motion.reduced.tokens.json"
          }
        ],
        "off": [
          {
            "$ref": "motion.off.tokens.json"
          }
        ]
      },
      "default": "full"
    }
  },
  "resolutionOrder": [
    {
      "$ref": "#/sets/base"
    },
    {
      "$ref": "#/modifiers/theme"
    },
    {
      "$ref": "#/modifiers/density"
    },
    {
      "$ref": "#/modifiers/motion"
    }
  ]
}
