{
  "name": "yorha-design-system",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Unofficial fan-made YoRHa-inspired design system (source-copy registry, Storybook SOT)",
  "license": "MIT",
  "engines": {
    "node": ">=22.22"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:storybook": "vitest run --project storybook",
    "test:vrt": "vitest run --project vrt",
    "test:text-spacing": "vitest run --project text-spacing",
    "test:stability": "vitest run --project stability",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build -o storybook-static --quiet",
    "docs:axe": "node scripts/docs-axe.mjs",
    "tokens:build": "node scripts/build-tokens.mjs",
    "scaffold:paths": "node scripts/sync-paths.mjs",
    "registry:validate": "shadcn registry validate",
    "registry:lint": "node scripts/lint-registry.mjs",
    "coverage:base-ui": "node scripts/base-ui-coverage.mjs",
    "registry:build": "shadcn build -o public/r",
    "e2e:registry": "bash e2e/install.sh",
    "lint:secrets": "gitleaks detect --no-banner --redact"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@fontsource-variable/noto-sans-jp": "5.3.1",
    "@fontsource-variable/noto-sans-kr": "5.3.1",
    "@fontsource/m-plus-1-code": "5.3.1",
    "@fontsource/zen-kaku-gothic-new": "5.3.1",
    "@playwright/test": "1.65.0",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/addon-vitest": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@vitest/browser-playwright": "5.1.0",
    "playwright": "1.65.0",
    "pretendard": "1.3.9",
    "react-router": "8.5.1",
    "shadcn": "4.23.0",
    "storybook": "10.6.7",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
