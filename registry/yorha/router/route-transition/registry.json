{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "items": [
    {
      "name": "route-transition",
      "type": "registry:component",
      "title": "RouteTransition",
      "description": "Renders <Outlet/> inside React <ViewTransition> so route changes animate as YoRHa panel motion. Disabled when data-motion is reduced or off.",
      "dependencies": [
        "react-router@^8.5.1"
      ],
      "registryDependencies": [
        "@yorha/base",
        "@yorha/utils"
      ],
      "files": [
        {
          "path": "route-transition.tsx",
          "type": "registry:component",
          "target": "@components/route-transition.tsx"
        }
      ],
      "css": {
        "::view-transition-old(.yorha-route-exit)": {
          "animation": "yorha-route-out var(--motion-panel-exit) var(--yorha-ease-in) both"
        },
        "::view-transition-new(.yorha-route-enter)": {
          "animation": "yorha-route-in var(--motion-panel) var(--yorha-ease-out) both"
        },
        "@keyframes yorha-route-in": {
          "from": {
            "opacity": "0",
            "transform": "translateX(-0.5rem)"
          },
          "to": {
            "opacity": "1",
            "transform": "none"
          }
        },
        "@keyframes yorha-route-out": {
          "from": {
            "opacity": "1"
          },
          "to": {
            "opacity": "0"
          }
        }
      },
      "docs": "Unofficial fan project, not affiliated with Square Enix or PlatinumGames. Needs React 19.3+ (stable ViewTransition) and navigation inside a transition (RouterProvider does this). Replaces react-router's deprecated viewTransition APIs; never calls document.startViewTransition."
    }
  ]
}
